{
  "type": "custom-component",
  "name": "dashboard-shell-activity",
  "description": "## Dashboard Shell Activity\nResponsive, accessible recent-activity list for the `dashboard-shell` component.\nRenders each activity title, description, timestamp, and an optional status indicator,\nwith a friendly empty state when no activities are supplied.\n",
  "children": [
    {
      "name": "section",
      "attributes": [
        {
          "property": "aria-label",
          "value": "Recent activity"
        }
      ],
      "classList": [
        "w-full"
      ],
      "children": [
        {
          "name": "div",
          "classList": [
            "mb-4"
          ],
          "layout": {
            "container": {
              "type": "box",
              "orientation": "column",
              "crossAxisAlignment": "stretch",
              "gap": "0.25rem"
            }
          },
          "children": [
            {
              "name": "h2",
              "classList": [
                "text-base",
                "font-semibold",
                "text-slate-900"
              ],
              "layout": {
                "cell": {
                  "type": "box-item"
                }
              },
              "children": [
                {
                  "name": "text",
                  "textContent": "Recent activity",
                  "evaluate": false
                }
              ]
            },
            {
              "name": "p",
              "classList": [
                "text-sm",
                "text-slate-500"
              ],
              "layout": {
                "cell": {
                  "type": "box-item"
                }
              },
              "children": [
                {
                  "name": "text",
                  "textContent": "Keep track of the latest updates across your workspace.",
                  "evaluate": false
                }
              ]
            }
          ]
        },
        {
          "name": "div",
          "attributes": [
            {
              "property": "aria-live",
              "value": "polite"
            }
          ],
          "classList": [
            "rounded-lg",
            "border",
            "border-dashed",
            "border-slate-300",
            "bg-slate-50",
            "px-6",
            "py-10",
            "text-center"
          ],
          "displayExpression": "$ctrl.activities.length === 0",
          "children": [
            {
              "name": "p",
              "classList": [
                "text-sm",
                "font-medium",
                "text-slate-700"
              ],
              "children": [
                {
                  "name": "text",
                  "textContent": "No recent activity yet",
                  "evaluate": false
                }
              ]
            },
            {
              "name": "p",
              "classList": [
                "mt-1",
                "text-sm",
                "text-slate-500"
              ],
              "children": [
                {
                  "name": "text",
                  "textContent": "New updates will appear here when they happen.",
                  "evaluate": false
                }
              ]
            }
          ],
          "comments": "Friendly fallback shown when the input array is empty or contains no activity records."
        },
        {
          "name": "ul",
          "attributes": [
            {
              "property": "role",
              "value": "list"
            },
            {
              "property": "aria-live",
              "value": "polite"
            }
          ],
          "classList": [
            "w-full"
          ],
          "displayExpression": "$ctrl.activities.length > 0",
          "layout": {
            "container": {
              "type": "box",
              "orientation": "column",
              "crossAxisAlignment": "stretch",
              "gap": "0.75rem"
            }
          },
          "children": [
            {
              "name": "li",
              "classList": [
                "rounded-lg",
                "border",
                "border-slate-200",
                "bg-white",
                "p-4",
                "shadow-sm"
              ],
              "iterate": {
                "array": "$ctrl.activities",
                "variable": "activity"
              },
              "layout": {
                "cell": {
                  "type": "box-item",
                  "growFactor": 0,
                  "shrinkFactor": 0,
                  "mainSize": "auto"
                }
              },
              "children": [
                {
                  "name": "div",
                  "classList": [],
                  "layout": {
                    "container": {
                      "type": "box",
                      "orientation": "column",
                      "crossAxisAlignment": "stretch",
                      "gap": "0.5rem"
                    }
                  },
                  "children": [
                    {
                      "name": "div",
                      "classList": [],
                      "layout": {
                        "container": {
                          "type": "box",
                          "orientation": "row",
                          "crossAxisAlignment": "center",
                          "mainAxisAlignment": "space-between",
                          "gap": "0.75rem"
                        },
                        "cell": {
                          "type": "box-item",
                          "growFactor": 0,
                          "shrinkFactor": 0,
                          "mainSize": "auto"
                        }
                      },
                      "children": [
                        {
                          "name": "h3",
                          "classList": [
                            "min-w-0",
                            "flex-1",
                            "text-sm",
                            "font-semibold",
                            "text-slate-900"
                          ],
                          "layout": {
                            "cell": {
                              "type": "box-item"
                            }
                          },
                          "children": [
                            {
                              "name": "text",
                              "textContent": "activity.title",
                              "evaluate": true
                            }
                          ]
                        },
                        {
                          "name": "span",
                          "attributes": [
                            {
                              "property": "aria-label",
                              "value": "'Status: ' + activity.status",
                              "evaluate": "true"
                            }
                          ],
                          "classList": [
                            "inline-flex",
                            "shrink-0",
                            "items-center",
                            "gap-1.5",
                            "rounded-full",
                            "bg-slate-100",
                            "px-2",
                            "py-1",
                            "text-xs",
                            "font-medium",
                            "text-slate-700"
                          ],
                          "displayExpression": "activity.status",
                          "layout": {
                            "cell": {
                              "type": "box-item"
                            }
                          },
                          "children": [
                            {
                              "name": "span",
                              "attributes": [
                                {
                                  "property": "aria-hidden",
                                  "value": "true"
                                }
                              ],
                              "classList": [
                                "h-1.5",
                                "w-1.5",
                                "rounded-full",
                                "bg-slate-500"
                              ],
                              "children": []
                            },
                            {
                              "name": "text",
                              "textContent": "activity.status",
                              "evaluate": true
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "p",
                      "classList": [
                        "text-sm",
                        "leading-6",
                        "text-slate-600"
                      ],
                      "layout": {
                        "cell": {
                          "type": "box-item",
                          "growFactor": 0,
                          "shrinkFactor": 0,
                          "mainSize": "auto"
                        }
                      },
                      "children": [
                        {
                          "name": "text",
                          "textContent": "activity.description",
                          "evaluate": true
                        }
                      ]
                    },
                    {
                      "name": "time",
                      "attributes": [
                        {
                          "property": "datetime",
                          "value": "activity.timestamp",
                          "evaluate": "true"
                        }
                      ],
                      "classList": [
                        "text-xs",
                        "text-slate-500"
                      ],
                      "layout": {
                        "cell": {
                          "type": "box-item",
                          "growFactor": 0,
                          "shrinkFactor": 0,
                          "mainSize": "auto"
                        }
                      },
                      "children": [
                        {
                          "name": "text",
                          "textContent": "activity.timestamp",
                          "evaluate": true
                        }
                      ]
                    }
                  ]
                }
              ],
              "comments": "Each activity record expects title, description, and timestamp; status is optional and omitted when absent."
            }
          ],
          "comments": "Single-column responsive list: each item stacks naturally on narrow screens and keeps readable spacing on larger screens."
        }
      ],
      "comments": "Accessible activity region: semantic list markup is paired with a polite live region so updates can be announced without disrupting the page."
    }
  ],
  "variables": [],
  "bindings": [
    {
      "name": "activities",
      "type": "<",
      "default": "[]",
      "description": "Activity records to display. Each item may provide `title`, `description`, `timestamp`, and optional `status`.\n",
      "visibleWhen": "",
      "label": "",
      "group": "",
      "example": "",
      "actions": [],
      "propertyType": "array",
      "enumOptions": [],
      "elementsProperties": []
    }
  ],
  "modules": [],
  "styles": []
}